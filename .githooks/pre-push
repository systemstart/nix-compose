#!/usr/bin/env bash
# Reject pushes containing unsigned commits.
#
# pre-push, not pre-commit: a commit's signature is created when the commit
# object is written, after pre-commit runs, so at pre-commit time there is
# nothing to verify. Here the commits exist and can be checked for real.
#
# Tracked in .githooks so every clone gets the same guard, but it only runs
# once that clone opts in:
#
#   git config core.hooksPath .githooks     # or `make hooks`
#
# It does not affect Renovate or any CI bot — they push from their own
# infrastructure and never run these hooks. Server-side enforcement would be
# GitHub's "require signed commits" branch rule instead.
#
# Bypass for a one-off:  git push --no-verify

set -uo pipefail

fail=0

is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

while read -r _local_ref local_sha _remote_ref remote_sha; do
  is_zero "$local_sha" && continue          # branch deletion

  if is_zero "$remote_sha" || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # New branch, or the server's tip is not in this clone (someone
    # pushed since the last fetch — the push will be rejected, but the
    # range below would print "fatal: Invalid revision range" first):
    # check the commits not already published on any remote-tracking ref.
    mapfile -t commits < <(git rev-list "$local_sha" --not --remotes)
  else
    # Also skip what any remote-tracking ref has: a force push of a branch
    # rebased onto a moved main carries main's new commits in
    # remote..local, and those are on the server already — GitHub's own
    # merge commits among them, signed with a key no clone has (2026-11-08,
    # a merge commit refused as unsigned: "E").
    mapfile -t commits < <(git rev-list "$local_sha" --not "$remote_sha" --remotes)
  fi

  for c in ${commits+"${commits[@]}"}; do
    sig=$(git log -1 --format='%G?' "$c" 2>/dev/null)
    case "$sig" in
      G|U) ;;
      *)
        [ "$fail" = 0 ] && echo "unsigned commits in this push:" >&2
        printf '  %s %s %s\n' "$(git rev-parse --short "$c")" "${sig:-?}" \
          "$(git log -1 --format=%s "$c")" >&2
        fail=1 ;;
    esac
  done
done

if [ "$fail" != 0 ]; then
  cat >&2 <<'MSG'

sign them first:
  git sign-branch          # or: git rebase --force-rebase --gpg-sign <base>

push anyway with:
  git push --no-verify
MSG
  exit 1
fi
