{
  "services": {
    "api": {
      "image": "node:18",
      "ports": ["3000:3000"],
      "depends_on": {
        "db": {"condition": "service_healthy"}
      },
      "x-nix-compose": {
        "initContainers": [
          {
            "name": "migrate",
            "image": "flyway:latest",
            "command": ["flyway", "migrate"],
            "environment": {"DB_URL": "postgres://db:5432/app"},
            "volumes": ["/migrations:/flyway/sql"]
          },
          {
            "name": "seed",
            "image": "node:18",
            "command": ["node", "seed.js"]
          }
        ]
      }
    },
    "db": {
      "image": "postgres:15",
      "healthcheck": {
        "test": ["CMD", "pg_isready"],
        "interval": "5s",
        "retries": 3
      }
    }
  }
}
