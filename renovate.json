{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "commitMessagePrefix": "ci(deps):"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "nixpkgs"
      ],
      "commitMessageExtra": "({{{newVersion}}})"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "nix-oci"
      ],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageExtra": "({{{newVersion}}})"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "commitMessagePrefix": "build(deps):"
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "go-overlay"
      ],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageExtra": "({{{newVersion}}})"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Go release pinned in flake.nix and provided by go-overlay. nixpkgs' default `go` is not what this repo builds with, so the gomod manager's view of the go directive is not the thing to track.",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*goVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    }
  ]
}
